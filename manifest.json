{
  "manifest_version": 3,
  "name": "myVideo Dual Transcript (V4.0 Passive Stable)",
  "version": "4.0.1",
  "description": "被動監聽版：需手動觸發原廠字幕。支援單選模式與原廠字幕隱藏。",
  "permissions": [
    "scripting",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.myvideo.net.tw/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "myVideo 字幕設定"
  },
  "content_scripts": [
    {
      "matches": ["https://*.myvideo.net.tw/*"],
      "js": ["content_script.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}