{
  "manifest_version": 3,
  "name": "MyVideo DualSub - MyVideo雙語字幕小幫手",
  "version": "1.7",
  "description": "被動監聽版：需手動觸發原廠字幕。支援單選模式與原廠字幕隱藏。",
  "permissions": [
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.myvideo.net.tw/*",
    "https://*.cdn.tfn.net.tw/*",
    "https://vodstrm.myvideo.net.tw/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "雙語字幕小幫手"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.myvideo.net.tw/*",
        "https://*.cdn.tfn.net.tw/*",
        "https://vodstrm.myvideo.net.tw/*"
      ],
      "js": ["vocabulary.js", "content_script.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["wordlist.json", "basic_vocab.json"],
      "matches": ["<all_urls>"]
    }
  ]
}